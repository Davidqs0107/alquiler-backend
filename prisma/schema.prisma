generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                       String                     @id @default(cuid())
  companyId                String
  name                     String
  status                   RecordStatus               @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  Company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  BranchCategoryVisibility BranchCategoryVisibility[]
  BranchUser               BranchUser[]
  RatePlan                 RatePlan[]
  RentalSession            RentalSession[]
  Resource                 Resource[]
  SaleCatalogItem          SaleCatalogItem[]
  Ticket                   Ticket[]

  @@unique([companyId, name])
  @@index([companyId])
}

model BranchCategoryVisibility {
  id                 String           @id @default(cuid())
  companyId          String
  branchId           String
  resourceCategoryId String
  isVisible          Boolean
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  Branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ResourceCategory   ResourceCategory @relation(fields: [resourceCategoryId], references: [id], onDelete: Cascade)

  @@unique([branchId, resourceCategoryId])
  @@index([companyId, branchId])
  @@index([companyId])
}

model BranchUser {
  id        String       @id @default(cuid())
  branchId  String
  userId    String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  Branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  User      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([branchId])
  @@index([userId])
}

model Company {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  status                   RecordStatus               @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  Branch                   Branch[]
  BranchCategoryVisibility BranchCategoryVisibility[]
  CompanyUser              CompanyUser[]
  Customer                 Customer[]
  Payment                  Payment[]
  PaymentReversal          PaymentReversal[]
  RatePlan                 RatePlan[]
  RentalSession            RentalSession[]
  Resource                 Resource[]
  ResourceCategory         ResourceCategory[]
  SaleCatalogItem          SaleCatalogItem[]
  Ticket                   Ticket[]
}

model CompanyUser {
  id        String         @id @default(cuid())
  companyId String
  userId    String
  role      MembershipRole
  status    RecordStatus   @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  Company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model Customer {
  id            String          @id @default(cuid())
  companyId     String
  name          String
  email         String?
  phone         String?
  status        RecordStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  Company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  RentalSession RentalSession[]
  Ticket        Ticket[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Payment {
  id              String            @id @default(cuid())
  companyId       String
  ticketId        String
  method          PaymentMethod
  amount          Decimal           @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Ticket          Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  PaymentReversal PaymentReversal[]

  @@index([companyId])
  @@index([ticketId])
}

model PaymentReversal {
  id          String   @id @default(cuid())
  companyId   String
  ticketId    String
  paymentId   String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [createdById], references: [id])
  Payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  Ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdById])
  @@index([paymentId])
  @@index([ticketId])
}

model RatePlan {
  id                 String            @id @default(cuid())
  companyId          String
  branchId           String
  resourceCategoryId String?
  resourceId         String?
  name               String
  pricingType        PricingType
  basePrice          Decimal           @db.Decimal(12, 2)
  timeUnitMinutes    Int?
  status             RecordStatus      @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  Branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ResourceCategory   ResourceCategory? @relation(fields: [resourceCategoryId], references: [id])
  Resource           Resource?         @relation(fields: [resourceId], references: [id])
  RatePlanRule       RatePlanRule[]

  @@index([companyId, branchId])
  @@index([companyId])
}

model RatePlanRule {
  id            String   @id @default(cuid())
  ratePlanId    String
  name          String
  dayOfWeek     Int?
  startMinute   Int?
  endMinute     Int?
  priceOverride Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  RatePlan      RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId])
}

model RentalSession {
  id               String              @id @default(cuid())
  companyId        String
  branchId         String
  resourceId       String
  ticketItemId     String              @unique
  status           RentalSessionStatus @default(RESERVED)
  startAt          DateTime
  scheduledEndAt   DateTime
  endedAt          DateTime?
  reservedMinutes  Int
  usedMinutes      Int?
  overtimeMinutes  Int?                @default(0)
  ratePlanSnapshot Json?
  baseAmount       Decimal             @default(0) @db.Decimal(12, 2)
  overtimeAmount   Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt        DateTime            @default(now())
  updatedAt          DateTime         @updatedAt
  customerId       String?
  extensions       Json?
  Branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Customer         Customer?           @relation(fields: [customerId], references: [id])
  Resource         Resource            @relation(fields: [resourceId], references: [id])
  TicketItem       TicketItem          @relation(fields: [ticketItemId], references: [id], onDelete: Cascade)

  @@index([companyId, branchId])
  @@index([companyId])
  @@index([resourceId, startAt, scheduledEndAt])
  @@index([status])
}

model Resource {
  id                 String             @id @default(cuid())
  companyId          String
  branchId           String
  resourceCategoryId String
  name               String
  status             RecordStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  description        String?
  image              String?
  location           String?
  maxCapacity        Int?
  RatePlan           RatePlan[]
  RentalSession      RentalSession[]
  Branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ResourceCategory   ResourceCategory   @relation(fields: [resourceCategoryId], references: [id])
  ResourceBlockout   ResourceBlockout[]

  @@unique([branchId, name])
  @@index([companyId, branchId])
  @@index([companyId])
}

model ResourceBlockout {
  id         String   @id @default(cuid())
  resourceId String
  startAt    DateTime
  endAt      DateTime
  reason     String
  createdAt  DateTime @default(now())
  Resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model ResourceCategory {
  id                       String                     @id @default(cuid())
  companyId                String
  name                     String
  status                   RecordStatus               @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  description              String?
  BranchCategoryVisibility BranchCategoryVisibility[]
  RatePlan                 RatePlan[]
  Resource                 Resource[]
  Company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model SaleCatalogItem {
  id        String          @id @default(cuid())
  companyId String
  branchId  String?
  type      CatalogItemType
  name      String
  price     Decimal         @db.Decimal(12, 2)
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Branch    Branch?         @relation(fields: [branchId], references: [id])
  Company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, branchId])
  @@index([companyId])
}

model Ticket {
  id                 String            @id @default(cuid())
  companyId          String
  branchId           String
  openedById         String
  ticketNumber       Int
  status             TicketStatus      @default(OPEN)
  subtotal           Decimal           @default(0) @db.Decimal(12, 2)
  total              Decimal           @default(0) @db.Decimal(12, 2)
  openedAt           DateTime          @default(now())
  closedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  cancellationReason String?
  cancelledAt        DateTime?
  discountAmount     Decimal           @default(0) @db.Decimal(12, 2)
  discountReason     String?
  customerId         String?
  Payment            Payment[]
  PaymentReversal    PaymentReversal[]
  Branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Customer           Customer?         @relation(fields: [customerId], references: [id])
  User               User              @relation(fields: [openedById], references: [id])
  TicketItem         TicketItem[]

  @@unique([branchId, ticketNumber])
  @@index([companyId, branchId])
  @@index([companyId])
  @@index([openedAt])
  @@index([status])
}

model TicketItem {
  id                 String         @id @default(cuid())
  ticketId           String
  type               TicketItemType
  description        String
  quantity           Decimal        @db.Decimal(12, 2)
  unitPrice          Decimal        @db.Decimal(12, 2)
  subtotal           Decimal        @db.Decimal(12, 2)
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cancellationReason String?
  cancelledAt        DateTime?
  discountAmount     Decimal        @default(0) @db.Decimal(12, 2)
  discountReason     String?
  RentalSession      RentalSession?
  Ticket             Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  globalRole      GlobalRole        @default(USER)
  status          RecordStatus      @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  BranchUser      BranchUser[]
  CompanyUser     CompanyUser[]
  PaymentReversal PaymentReversal[]
  Ticket          Ticket[]
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum GlobalRole {
  SUPERADMIN
  USER
}

enum MembershipRole {
  ADMIN_EMPRESA
  ADMIN_SEDE
  CAJERO
  RECEPCION
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIGITAL_WALLET
  OTHER
}

enum PricingType {
  BLOCK
  TIME_UNIT
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum RentalSessionStatus {
  RESERVED
  IN_USE
  FINISHED
  CANCELLED
}

enum TicketItemType {
  RENTAL
  PRODUCT
  EXTRA
  MANUAL
}

enum TicketStatus {
  OPEN
  CLOSED
  CANCELLED
}
